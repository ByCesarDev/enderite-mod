{
  "namespace": "chest",

  "chest_label": {
    "$new_container_title|default": "$container_title",
    "text": "$new_container_title"
  },

  "small_chest_screen": {
    "$new_container_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'tile.ed:enderite_shulker_box.name')",
          "$screen_content": "ed-enderite_shulker_box.shulker_panel",
          "$screen_bg_content": "common.screen_background"
        }
      }
    ]
  }
}
